{
  "manifest_version": 3,
  "name": "Favicon Downloader",
  "version": "2.0",
  "description": "Download the highest resolution favicon as a 512x512 PNG",
  "permissions": [
    "activeTab",
    "downloads",
    "clipboardWrite",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
